<section class="mx-auto max-w-5xl space-y-8">
  <div>
    <p class="text-sm uppercase tracking-[0.2em] text-stone-400">New Booking</p>
    <h1 class="mt-3 text-4xl font-semibold text-stone-50">Create a booking draft</h1>
  </div>

  <%= form_with model: @booking, class: "panel space-y-8" do |form| %>
    <% if @booking.errors.any? %>
      <div class="rounded-2xl border border-rose-400/40 bg-rose-500/10 px-4 py-3 text-sm text-rose-100">
        <%= @booking.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div class="grid gap-6 md:grid-cols-2">
      <div>
        <%= form.label :product_id, "Product", class: "field-label" %>
        <%= form.select :product_id, @products.map { |product| [product.name, product.id] }, { prompt: "Select product" }, class: "field-input" %>
      </div>
      <div>
        <%= form.label :departure_id, "Departure", class: "field-label" %>
        <%= form.select :departure_id, current_tenant.departures.order(:departure_date).map { |departure| ["#{departure.product.name} - #{departure.departure_date}", departure.id] }, { prompt: "Select departure" }, class: "field-input" %>
      </div>
      <div>
        <%= form.label :lead_traveler_name, class: "field-label" %>
        <%= form.text_field :lead_traveler_name, class: "field-input", placeholder: "Lead traveler full name" %>
      </div>
      <div>
        <%= form.label :lead_traveler_email, class: "field-label" %>
        <%= form.email_field :lead_traveler_email, class: "field-input", placeholder: "lead@example.test" %>
      </div>
      <div>
        <%= form.label :travelers_count, class: "field-label" %>
        <%= form.number_field :travelers_count, class: "field-input", min: 1 %>
      </div>
      <div>
        <%= form.label :payment_plan, class: "field-label" %>
        <%= form.text_field :payment_plan, class: "field-input", placeholder: "Full upfront / installment" %>
      </div>
      <div class="md:col-span-2">
        <%= form.label :notes, class: "field-label" %>
        <%= form.text_area :notes, rows: 4, class: "field-input", placeholder: "Special rooming, airport notes, lead source" %>
      </div>
    </div>

    <div class="flex flex-wrap gap-3">
      <%= form.submit "Create booking", class: "btn-primary" %>
      <%= link_to "Back to bookings", bookings_path, class: "btn-secondary" %>
    </div>
  <% end %>
</section>
