<section class="space-y-8">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <p class="text-sm uppercase tracking-[0.2em] text-stone-400"><%= @booking.status.humanize %></p>
      <h1 class="mt-3 text-4xl font-semibold text-stone-50"><%= @booking.booking_ref %></h1>
      <p class="mt-2 text-stone-300"><%= @booking.lead_traveler_name %> • <%= @booking.lead_traveler_email %></p>
    </div>
    <div class="flex flex-wrap gap-3">
      <%= link_to "Add traveler", new_booking_traveler_path(@booking), class: "btn-secondary" %>
      <%= link_to "Record payment", new_booking_payment_path(@booking), class: "btn-primary" %>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-4">
    <div class="panel">
      <p class="text-sm text-stone-400">Product</p>
      <p class="mt-3 text-2xl font-semibold text-stone-50"><%= @booking.product.name %></p>
    </div>
    <div class="panel">
      <p class="text-sm text-stone-400">Departure</p>
      <p class="mt-3 text-2xl font-semibold text-stone-50"><%= @booking.departure.departure_date %></p>
    </div>
    <div class="panel">
      <p class="text-sm text-stone-400">Total</p>
      <p class="mt-3 text-2xl font-semibold text-stone-50"><%= currency_amount(@booking.total_price_cents, @booking.currency) %></p>
    </div>
    <div class="panel">
      <p class="text-sm text-stone-400">Outstanding</p>
      <p class="mt-3 text-2xl font-semibold text-stone-50"><%= currency_amount(@booking.outstanding_cents, @booking.currency) %></p>
    </div>
  </div>

  <div class="grid gap-6 xl:grid-cols-[1fr_1fr_1fr]">
    <div class="panel">
      <div class="mb-5 flex items-center justify-between">
        <p class="text-sm uppercase tracking-[0.2em] text-stone-400">Travelers</p>
        <span class="text-sm text-stone-400"><%= @travelers.size %> recorded</span>
      </div>
      <div class="space-y-4">
        <% @travelers.each do |traveler| %>
          <div class="rounded-3xl border border-white/10 bg-black/15 p-4">
            <p class="font-medium text-stone-100"><%= traveler.full_name %></p>
            <p class="text-sm text-stone-500"><%= traveler.status.humanize %></p>
            <% if traveler.passport_number.present? %>
              <p class="mt-2 text-sm text-stone-300">Passport <%= traveler.passport_number %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="panel">
      <div class="mb-5 flex items-center justify-between">
        <p class="text-sm uppercase tracking-[0.2em] text-stone-400">Payments</p>
        <span class="text-sm text-stone-400"><%= @payments.size %> recorded</span>
      </div>
      <div class="space-y-4">
        <% @payments.each do |payment| %>
          <div class="rounded-3xl border border-white/10 bg-black/15 p-4">
            <p class="font-medium text-stone-100"><%= currency_amount(payment.amount_cents, payment.currency) %></p>
            <p class="text-sm text-stone-500"><%= payment.payment_method.humanize %> • <%= payment.status.humanize %></p>
            <p class="mt-2 text-sm text-stone-300"><%= payment.paid_at&.strftime("%Y-%m-%d %H:%M") %></p>
          </div>
        <% end %>
      </div>
    </div>

    <div class="panel">
      <div class="mb-5 flex items-center justify-between">
        <p class="text-sm uppercase tracking-[0.2em] text-stone-400">Ledger</p>
        <span class="text-sm text-stone-400"><%= @ledger_entries.size %> entries</span>
      </div>
      <div class="space-y-4">
        <% @ledger_entries.each do |entry| %>
          <div class="rounded-3xl border border-white/10 bg-black/15 p-4">
            <p class="font-medium text-stone-100"><%= currency_amount(entry.amount_cents, entry.currency) %></p>
            <p class="text-sm text-stone-500"><%= entry.debit_account %> -> <%= entry.credit_account %></p>
            <p class="mt-2 text-sm text-stone-300"><%= entry.description %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <% if @support_cases.any? %>
    <div class="panel">
      <div class="mb-5 flex items-center justify-between">
        <div>
          <p class="text-sm uppercase tracking-[0.2em] text-stone-400">Linked support cases</p>
          <h2 class="mt-2 text-2xl font-semibold text-stone-50">Customer servicing</h2>
        </div>
        <%= link_to "Open support inbox", support_cases_path, class: "btn-secondary" %>
      </div>

      <div class="space-y-4">
        <% @support_cases.each do |support_case| %>
          <div class="rounded-3xl border border-white/10 bg-black/15 p-4">
            <p class="font-medium text-stone-100"><%= support_case.case_ref %> • <%= support_case.subject %></p>
            <p class="text-sm text-stone-500"><%= support_case.status.humanize %> • <%= support_case.assigned_user&.full_name || "Unassigned" %></p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</section>
