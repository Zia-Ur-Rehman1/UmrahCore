<% if current_user.platform_admin? && current_tenant.blank? %>
  <section class="space-y-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm uppercase tracking-[0.2em] text-stone-400">Platform Console</p>
        <h1 class="mt-3 text-4xl font-semibold text-stone-50">Tenant provisioning control plane</h1>
      </div>
      <%= link_to "Create tenant", new_platform_tenant_path, class: "btn-primary" %>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      <div class="panel">
        <p class="text-sm text-stone-400">Tenants</p>
        <p class="mt-3 text-4xl font-semibold text-stone-50"><%= @tenants.size %></p>
      </div>
      <div class="panel">
        <p class="text-sm text-stone-400">Active tenants</p>
        <p class="mt-3 text-4xl font-semibold text-stone-50"><%= @tenants.count(&:status_active?) %></p>
      </div>
      <div class="panel">
        <p class="text-sm text-stone-400">Owners provisioned</p>
        <p class="mt-3 text-4xl font-semibold text-stone-50"><%= @tenants.sum { |tenant| tenant.users.count } %></p>
      </div>
    </div>

    <div class="panel overflow-hidden">
      <div class="mb-6 flex items-center justify-between">
        <div>
          <p class="text-sm uppercase tracking-[0.2em] text-stone-400">Recent tenants</p>
          <h2 class="mt-2 text-2xl font-semibold text-stone-50">Current platform footprint</h2>
        </div>
        <%= link_to "Open provisioning queue", platform_tenants_path, class: "btn-secondary" %>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full text-left text-sm">
          <thead class="text-stone-400">
            <tr>
              <th class="pb-3 pr-4 font-medium">Tenant</th>
              <th class="pb-3 pr-4 font-medium">Tier</th>
              <th class="pb-3 pr-4 font-medium">Isolation</th>
              <th class="pb-3 pr-4 font-medium">Primary host</th>
              <th class="pb-3 font-medium">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            <% @tenants.each do |tenant| %>
              <tr>
                <td class="py-4 pr-4">
                  <p class="font-medium text-stone-100"><%= tenant.name %></p>
                  <p class="text-stone-500"><%= tenant.slug %></p>
                </td>
                <td class="py-4 pr-4 text-stone-300"><%= tenant.tier.humanize %></td>
                <td class="py-4 pr-4 text-stone-300"><%= tenant.isolation_model.humanize %></td>
                <td class="py-4 pr-4 text-amber-100"><%= tenant.primary_host %></td>
                <td class="py-4 text-stone-300"><%= tenant.status.humanize %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
<% else %>
  <section class="space-y-8">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="text-sm uppercase tracking-[0.2em] text-emerald-300">Tenant Workspace</p>
        <h1 class="mt-3 text-4xl font-semibold text-stone-50"><%= current_tenant.name %></h1>
        <p class="mt-2 max-w-2xl text-stone-300">
          Tenant-aware dashboard resolved from <span class="text-stone-100"><%= request.host %></span>. This is the starting point for catalog, bookings, support, and finance modules.
        </p>
      </div>
      <div class="rounded-3xl border border-white/10 bg-white/5 px-5 py-4 text-sm text-stone-300">
        Signed in as <span class="font-semibold text-stone-50"><%= current_user.full_name %></span>
        (<%= current_user.platform_admin? ? "Platform Admin" : current_user.role.humanize %>)
      </div>
    </div>

    <div class="grid gap-4 md:grid-cols-4">
      <div class="panel">
        <p class="text-sm text-stone-400">Lifecycle status</p>
        <p class="mt-3 text-3xl font-semibold text-stone-50"><%= current_tenant.status.humanize %></p>
      </div>
      <div class="panel">
        <p class="text-sm text-stone-400">Isolation model</p>
        <p class="mt-3 text-3xl font-semibold text-stone-50"><%= current_tenant.isolation_model.humanize %></p>
      </div>
      <div class="panel">
        <p class="text-sm text-stone-400">Members</p>
        <p class="mt-3 text-3xl font-semibold text-stone-50"><%= @members.size %></p>
      </div>
      <div class="panel">
        <p class="text-sm text-stone-400">Payments received</p>
        <p class="mt-3 text-3xl font-semibold text-stone-50"><%= currency_amount(@payments_received_cents, "USD") %></p>
      </div>
    </div>

    <div class="flex flex-wrap gap-3">
      <%= link_to "Open catalog", products_path, class: "btn-primary" %>
      <%= link_to "Open bookings", bookings_path, class: "btn-secondary" %>
      <%= link_to "Support inbox", support_cases_path, class: "btn-secondary" %>
      <%= link_to "New product", new_product_path, class: "btn-secondary" %>
      <%= link_to "New booking", new_booking_path, class: "btn-secondary" %>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      <div class="panel">
        <p class="text-sm text-stone-400">Bookings</p>
        <p class="mt-3 text-3xl font-semibold text-stone-50"><%= @bookings_count %></p>
      </div>
      <div class="panel">
        <p class="text-sm text-stone-400">Outstanding</p>
        <p class="mt-3 text-3xl font-semibold text-stone-50"><%= currency_amount(@outstanding_cents, "USD") %></p>
      </div>
      <div class="panel">
        <p class="text-sm text-stone-400">Open cases</p>
        <p class="mt-3 text-3xl font-semibold text-stone-50"><%= @open_cases_count %></p>
      </div>
    </div>

    <div class="grid gap-6 xl:grid-cols-[0.8fr_1fr_1fr_0.9fr]">
      <div class="panel">
        <p class="text-sm uppercase tracking-[0.2em] text-stone-400">Domain mappings</p>
        <div class="mt-5 space-y-4">
          <% @domain_mappings.each do |mapping| %>
            <div class="rounded-3xl border border-white/10 bg-black/15 p-4">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <p class="font-medium text-stone-100"><%= mapping.host %></p>
                  <p class="text-sm text-stone-500"><%= mapping.kind.humanize %></p>
                </div>
                <% if mapping.primary? %>
                  <span class="rounded-full border border-emerald-400/40 bg-emerald-500/10 px-3 py-1 text-xs font-medium text-emerald-200">Primary</span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="panel">
        <p class="text-sm uppercase tracking-[0.2em] text-stone-400">Recent bookings</p>
        <div class="mt-5 space-y-4">
          <% @recent_bookings.each do |booking| %>
            <div class="rounded-3xl border border-white/10 bg-black/15 p-4">
              <p class="font-medium text-stone-100"><%= booking.booking_ref %></p>
              <p class="text-sm text-stone-500"><%= booking.lead_traveler_name %> • <%= booking.status.humanize %></p>
              <p class="mt-2 text-sm text-stone-300"><%= booking.product.name %> • <%= booking.departure.departure_date %></p>
            </div>
          <% end %>
        </div>
      </div>

      <div class="panel">
        <p class="text-sm uppercase tracking-[0.2em] text-stone-400">Recent cases</p>
        <div class="mt-5 space-y-4">
          <% @recent_cases.each do |support_case| %>
            <div class="rounded-3xl border border-white/10 bg-black/15 p-4">
              <p class="font-medium text-stone-100"><%= support_case.case_ref %></p>
              <p class="text-sm text-stone-500"><%= support_case.subject %></p>
              <p class="mt-2 text-sm text-stone-300"><%= support_case.status.humanize %> • <%= support_case.assigned_user&.full_name || "Unassigned" %></p>
            </div>
          <% end %>
        </div>
      </div>

      <div class="panel">
        <p class="text-sm uppercase tracking-[0.2em] text-stone-400">Workspace members</p>
        <div class="mt-5 space-y-4">
          <% @members.each do |member| %>
            <div class="rounded-3xl border border-white/10 bg-black/15 p-4">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <p class="font-medium text-stone-100"><%= member.full_name %></p>
                  <p class="text-sm text-stone-500"><%= member.email %></p>
                </div>
                <span class="text-sm text-stone-300"><%= member.platform_admin? ? "Platform Admin" : member.role.humanize %></span>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>
<% end %>
