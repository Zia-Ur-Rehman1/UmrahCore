<section class="space-y-8">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <p class="text-sm uppercase tracking-[0.2em] text-sky-300">Client Portal</p>
      <h1 class="mt-3 text-4xl font-semibold text-stone-50">My bookings</h1>
      <p class="mt-2 max-w-2xl text-stone-300">
        Review booking status, payment progress, and departure timing for every booking assigned to your portal account.
      </p>
    </div>
    <%= link_to "Portal home", portal_dashboard_path, class: "btn-secondary" %>
  </div>

  <div class="space-y-4">
    <% @bookings.each do |booking| %>
      <article class="panel">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
          <div>
            <p class="text-sm uppercase tracking-[0.2em] text-stone-400"><%= booking.booking_ref %></p>
            <h2 class="mt-2 text-2xl font-semibold text-stone-50"><%= booking.product.name %></h2>
            <p class="mt-2 text-stone-300"><%= booking.departure.departure_date %> to <%= booking.departure.return_date %></p>
          </div>
          <div class="flex flex-wrap gap-3">
            <span class="rounded-full border border-white/10 px-3 py-1 text-sm text-stone-300"><%= booking.status.humanize %></span>
            <%= link_to "Open booking", portal_booking_path(booking), class: "btn-primary" %>
          </div>
        </div>

        <div class="mt-6 grid gap-3 md:grid-cols-4">
          <div class="rounded-2xl border border-white/10 bg-black/15 p-4">
            <p class="text-sm text-stone-500">Lead traveler</p>
            <p class="mt-2 text-stone-100"><%= booking.lead_traveler_name %></p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-black/15 p-4">
            <p class="text-sm text-stone-500">Travelers</p>
            <p class="mt-2 text-stone-100"><%= booking.travelers_count %></p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-black/15 p-4">
            <p class="text-sm text-stone-500">Paid</p>
            <p class="mt-2 text-stone-100"><%= currency_amount(booking.amount_paid_cents, booking.currency) %></p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-black/15 p-4">
            <p class="text-sm text-stone-500">Outstanding</p>
            <p class="mt-2 text-stone-100"><%= currency_amount(booking.outstanding_cents, booking.currency) %></p>
          </div>
        </div>
      </article>
    <% end %>
  </div>
</section>
