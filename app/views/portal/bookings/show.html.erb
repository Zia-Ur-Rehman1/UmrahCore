<section class="space-y-8">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <p class="text-sm uppercase tracking-[0.2em] text-sky-300">Booking detail</p>
      <h1 class="mt-3 text-4xl font-semibold text-stone-50"><%= @booking.booking_ref %></h1>
      <p class="mt-2 text-stone-300"><%= @booking.product.name %> • <%= @booking.departure.departure_date %> to <%= @booking.departure.return_date %></p>
    </div>
    <div class="flex flex-wrap gap-3">
      <span class="rounded-full border border-white/10 px-3 py-1 text-sm text-stone-300"><%= @booking.status.humanize %></span>
      <%= link_to "Back to my bookings", portal_bookings_path, class: "btn-secondary" %>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-4">
    <div class="panel">
      <p class="text-sm text-stone-400">Lead traveler</p>
      <p class="mt-3 text-2xl font-semibold text-stone-50"><%= @booking.lead_traveler_name %></p>
    </div>
    <div class="panel">
      <p class="text-sm text-stone-400">Travelers</p>
      <p class="mt-3 text-2xl font-semibold text-stone-50"><%= @booking.travelers_count %></p>
    </div>
    <div class="panel">
      <p class="text-sm text-stone-400">Paid</p>
      <p class="mt-3 text-2xl font-semibold text-stone-50"><%= currency_amount(@booking.amount_paid_cents, @booking.currency) %></p>
    </div>
    <div class="panel">
      <p class="text-sm text-stone-400">Outstanding</p>
      <p class="mt-3 text-2xl font-semibold text-stone-50"><%= currency_amount(@booking.outstanding_cents, @booking.currency) %></p>
    </div>
  </div>

  <div class="grid gap-6 xl:grid-cols-[1fr_0.9fr]">
    <div class="space-y-6">
      <div class="panel">
        <p class="text-sm uppercase tracking-[0.2em] text-stone-400">Travelers</p>
        <div class="mt-5 space-y-4">
          <% @travelers.each do |traveler| %>
            <div class="rounded-3xl border border-white/10 bg-black/15 p-4">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <p class="font-medium text-stone-100"><%= traveler.full_name %></p>
                  <p class="text-sm text-stone-500"><%= traveler.passport_number.presence || "Passport pending" %></p>
                </div>
                <span class="text-sm text-stone-300"><%= traveler.status.humanize %></span>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="panel">
        <p class="text-sm uppercase tracking-[0.2em] text-stone-400">Payments</p>
        <div class="mt-5 space-y-4">
          <% @payments.each do |payment| %>
            <div class="rounded-3xl border border-white/10 bg-black/15 p-4">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <p class="font-medium text-stone-100"><%= currency_amount(payment.amount_cents, payment.currency) %></p>
                  <p class="text-sm text-stone-500"><%= payment.payment_method.humanize %> • <%= payment.paid_at&.to_date || "Pending" %></p>
                </div>
                <span class="text-sm text-stone-300"><%= payment.status.humanize %></span>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <aside class="panel">
      <p class="text-sm uppercase tracking-[0.2em] text-stone-400">Support cases</p>
      <div class="mt-5 space-y-4">
        <% @support_cases.each do |support_case| %>
          <div class="rounded-3xl border border-white/10 bg-black/15 p-4">
            <p class="font-medium text-stone-100"><%= support_case.case_ref %></p>
            <p class="mt-2 text-sm text-stone-300"><%= support_case.subject %></p>
            <p class="mt-2 text-sm text-stone-500"><%= support_case.status.humanize %> • <%= support_case.assigned_user&.full_name || "Unassigned" %></p>
            <div class="mt-4 space-y-2 border-t border-white/5 pt-4">
              <% support_case.case_messages.order(created_at: :asc).last(3).each do |message| %>
                <div class="rounded-2xl border border-white/10 bg-stone-950/60 p-3 text-sm text-stone-300">
                  <span class="font-medium text-stone-100"><%= message.user.full_name %>:</span>
                  <%= message.body %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if @support_cases.empty? %>
          <p class="text-stone-400">No support cases are linked to this booking yet.</p>
        <% end %>
      </div>
    </aside>
  </div>
</section>
