<section class="mx-auto max-w-5xl space-y-8">
  <div>
    <p class="text-sm uppercase tracking-[0.2em] text-stone-400">New Case</p>
    <h1 class="mt-3 text-4xl font-semibold text-stone-50">Open a support case</h1>
  </div>

  <%= form_with model: @support_case, class: "panel space-y-8" do |form| %>
    <% if @support_case.errors.any? %>
      <div class="rounded-2xl border border-rose-400/40 bg-rose-500/10 px-4 py-3 text-sm text-rose-100">
        <%= @support_case.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div class="grid gap-6 md:grid-cols-2">
      <div>
        <%= form.label :subject, class: "field-label" %>
        <%= form.text_field :subject, class: "field-input" %>
      </div>
      <div>
        <%= form.label :booking_id, "Linked booking", class: "field-label" %>
        <%= form.select :booking_id, @bookings.map { |booking| [booking.booking_ref, booking.id] }, { include_blank: "No booking linked" }, class: "field-input" %>
      </div>
      <div>
        <%= form.label :contact_name, class: "field-label" %>
        <%= form.text_field :contact_name, class: "field-input" %>
      </div>
      <div>
        <%= form.label :contact_email, class: "field-label" %>
        <%= form.email_field :contact_email, class: "field-input" %>
      </div>
      <div>
        <%= form.label :priority, class: "field-label" %>
        <%= form.select :priority, SupportCase.priorities.keys.map { |value| [value.humanize, value] }, {}, class: "field-input" %>
      </div>
      <div>
        <%= form.label :assigned_user_id, "Assign to", class: "field-label" %>
        <%= form.select :assigned_user_id, @assignees.map { |user| [user.full_name, user.id] }, { include_blank: "Assign later" }, class: "field-input" %>
      </div>
      <div class="md:col-span-2">
        <%= form.label :initial_message, class: "field-label" %>
        <%= form.text_area :initial_message, rows: 5, class: "field-input" %>
      </div>
    </div>

    <div class="flex flex-wrap gap-3">
      <%= form.submit "Open case", class: "btn-primary" %>
      <%= link_to "Back to inbox", support_cases_path, class: "btn-secondary" %>
    </div>
  <% end %>
</section>
