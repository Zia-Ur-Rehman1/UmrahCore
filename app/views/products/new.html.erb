<section class="mx-auto max-w-5xl space-y-8">
  <div>
    <p class="text-sm uppercase tracking-[0.2em] text-stone-400">New Product</p>
    <h1 class="mt-3 text-4xl font-semibold text-stone-50">Create a travel product</h1>
  </div>

  <%= form_with model: @product, class: "panel space-y-8" do |form| %>
    <% if @product.errors.any? %>
      <div class="rounded-2xl border border-rose-400/40 bg-rose-500/10 px-4 py-3 text-sm text-rose-100">
        <%= @product.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div class="grid gap-6 md:grid-cols-2">
      <div>
        <%= form.label :name, class: "field-label" %>
        <%= form.text_field :name, class: "field-input", placeholder: "Premium Spring Umrah" %>
      </div>
      <div>
        <%= form.label :product_type, class: "field-label" %>
        <%= form.select :product_type, Product.product_types.keys.map { |value| [value.humanize, value] }, {}, class: "field-input" %>
      </div>
      <div class="md:col-span-2">
        <%= form.label :description, class: "field-label" %>
        <%= form.text_area :description, rows: 4, class: "field-input", placeholder: "Package summary, hotels, transport, and support details." %>
      </div>
      <div>
        <%= form.label :base_price_cents, "Base price", class: "field-label" %>
        <%= form.number_field :base_price_cents, class: "field-input", min: 0, step: 1000 %>
      </div>
      <div>
        <%= form.label :currency, class: "field-label" %>
        <%= form.text_field :currency, class: "field-input", maxlength: 3 %>
      </div>
      <div>
        <%= form.label :duration_nights, class: "field-label" %>
        <%= form.number_field :duration_nights, class: "field-input", min: 0 %>
      </div>
      <div>
        <%= form.label :status, class: "field-label" %>
        <%= form.select :status, Product.statuses.keys.map { |value| [value.humanize, value] }, {}, class: "field-input" %>
      </div>
      <div class="md:col-span-2">
        <%= form.label :inclusions, class: "field-label" %>
        <%= form.text_area :inclusions, rows: 3, class: "field-input", placeholder: "Visa support, hotels, transfers, ziyarah" %>
      </div>
    </div>

    <label class="flex items-center gap-3 text-sm text-stone-300">
      <%= form.check_box :b2c_enabled, class: "h-4 w-4 rounded border-white/10 bg-stone-900 text-amber-300" %>
      Enable this product for B2C storefront publishing
    </label>

    <div class="flex flex-wrap gap-3">
      <%= form.submit "Create product", class: "btn-primary" %>
      <%= link_to "Back to catalog", products_path, class: "btn-secondary" %>
    </div>
  <% end %>
</section>
