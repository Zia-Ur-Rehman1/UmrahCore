<section class="space-y-8">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <p class="text-sm uppercase tracking-[0.2em] text-stone-400"><%= @product.product_type.humanize %></p>
      <h1 class="mt-3 text-4xl font-semibold text-stone-50"><%= @product.name %></h1>
      <p class="mt-2 max-w-3xl text-stone-300"><%= @product.description %></p>
    </div>
    <div class="flex flex-wrap gap-3">
      <%= link_to "Back to catalog", products_path, class: "btn-secondary" %>
      <%= link_to "Add departure", new_product_departure_path(@product), class: "btn-primary" %>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-4">
    <div class="panel">
      <p class="text-sm text-stone-400">Status</p>
      <p class="mt-3 text-2xl font-semibold text-stone-50"><%= @product.status.humanize %></p>
    </div>
    <div class="panel">
      <p class="text-sm text-stone-400">Base price</p>
      <p class="mt-3 text-2xl font-semibold text-stone-50"><%= @product.currency %> <%= @product.base_price_cents %></p>
    </div>
    <div class="panel">
      <p class="text-sm text-stone-400">Duration</p>
      <p class="mt-3 text-2xl font-semibold text-stone-50"><%= @product.duration_nights %> nights</p>
    </div>
    <div class="panel">
      <p class="text-sm text-stone-400">B2C enabled</p>
      <p class="mt-3 text-2xl font-semibold text-stone-50"><%= @product.b2c_enabled? ? "Yes" : "No" %></p>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
    <div class="panel">
      <p class="text-sm uppercase tracking-[0.2em] text-stone-400">Inclusions</p>
      <p class="mt-4 whitespace-pre-line text-stone-300"><%= @product.inclusions.presence || "No inclusions captured yet." %></p>
    </div>

    <div class="panel">
      <div class="mb-5 flex items-center justify-between">
        <div>
          <p class="text-sm uppercase tracking-[0.2em] text-stone-400">Departures</p>
          <h2 class="mt-2 text-2xl font-semibold text-stone-50">Scheduled availability</h2>
        </div>
      </div>

      <div class="space-y-4">
        <% @departures.each do |departure| %>
          <div class="rounded-3xl border border-white/10 bg-black/15 p-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <p class="font-medium text-stone-100"><%= departure.departure_date %> to <%= departure.return_date || "TBD" %></p>
                <p class="text-sm text-stone-500"><%= departure.status.humanize %></p>
                <% if departure.notes.present? %>
                  <p class="mt-2 text-sm text-stone-300"><%= departure.notes %></p>
                <% end %>
              </div>
              <div class="flex gap-4 text-sm text-stone-300">
                <span>Capacity <strong class="text-stone-100"><%= departure.capacity %></strong></span>
                <span>Reserved <strong class="text-stone-100"><%= departure.reserved_count %></strong></span>
                <span>Confirmed <strong class="text-stone-100"><%= departure.confirmed_count %></strong></span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
