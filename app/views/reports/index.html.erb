<section class="space-y-8">
  <div class="flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between">
    <div>
      <p class="text-sm uppercase tracking-[0.2em] text-amber-300">Reporting</p>
      <h1 class="mt-3 text-4xl font-semibold text-stone-50">Exports and KPI snapshot</h1>
      <p class="mt-2 max-w-3xl text-stone-300">
        Operational metrics for <%= current_tenant.name %> across bookings, payments, and support cases in the selected reporting window.
      </p>
    </div>

    <%= form_with url: reports_path, method: :get, local: true, class: "panel flex flex-col gap-4 sm:flex-row sm:items-end" do |form| %>
      <div>
        <%= form.label :from, "From", class: "mb-2 block text-sm text-stone-300" %>
        <%= form.date_field :from, value: @from_date, class: "w-full rounded-2xl border border-white/10 bg-stone-950 px-4 py-3 text-stone-100" %>
      </div>
      <div>
        <%= form.label :to, "To", class: "mb-2 block text-sm text-stone-300" %>
        <%= form.date_field :to, value: @to_date, class: "w-full rounded-2xl border border-white/10 bg-stone-950 px-4 py-3 text-stone-100" %>
      </div>
      <%= form.submit "Refresh window", class: "btn-primary" %>
    <% end %>
  </div>

  <div class="grid gap-4 md:grid-cols-5">
    <div class="panel">
      <p class="text-sm text-stone-400">Bookings created</p>
      <p class="mt-3 text-3xl font-semibold text-stone-50"><%= @bookings_count %></p>
    </div>
    <div class="panel">
      <p class="text-sm text-stone-400">Gross booking value</p>
      <p class="mt-3 text-3xl font-semibold text-stone-50"><%= currency_amount(@gross_booking_value_cents, "USD") %></p>
    </div>
    <div class="panel">
      <p class="text-sm text-stone-400">Payments received</p>
      <p class="mt-3 text-3xl font-semibold text-stone-50"><%= currency_amount(@payments_received_cents, "USD") %></p>
    </div>
    <div class="panel">
      <p class="text-sm text-stone-400">Outstanding</p>
      <p class="mt-3 text-3xl font-semibold text-stone-50"><%= currency_amount(@outstanding_cents, "USD") %></p>
    </div>
    <div class="panel">
      <p class="text-sm text-stone-400">Open cases</p>
      <p class="mt-3 text-3xl font-semibold text-stone-50"><%= @open_cases_count %></p>
    </div>
  </div>

  <div class="grid gap-4 xl:grid-cols-3">
    <div class="panel">
      <p class="text-sm uppercase tracking-[0.2em] text-stone-400">Booking export</p>
      <p class="mt-4 text-stone-300">Download booking refs, traveler contacts, linked portal users, and balance state for the reporting window.</p>
      <%= link_to "Download CSV", bookings_reports_path(from: @from_date, to: @to_date, format: :csv), class: "btn-primary mt-5 inline-flex" %>
    </div>
    <div class="panel">
      <p class="text-sm uppercase tracking-[0.2em] text-stone-400">Payment export</p>
      <p class="mt-4 text-stone-300">Download succeeded and pending payment rows with booking references and payment methods.</p>
      <%= link_to "Download CSV", payments_reports_path(from: @from_date, to: @to_date, format: :csv), class: "btn-primary mt-5 inline-flex" %>
    </div>
    <div class="panel">
      <p class="text-sm uppercase tracking-[0.2em] text-stone-400">Support export</p>
      <p class="mt-4 text-stone-300">Download case load, priorities, and assignee coverage for the current reporting window.</p>
      <%= link_to "Download CSV", support_cases_reports_path(from: @from_date, to: @to_date, format: :csv), class: "btn-primary mt-5 inline-flex" %>
    </div>
  </div>

  <div class="grid gap-6 xl:grid-cols-3">
    <div class="panel">
      <p class="text-sm uppercase tracking-[0.2em] text-stone-400">Recent bookings</p>
      <div class="mt-5 space-y-4">
        <% @bookings.limit(5).each do |booking| %>
          <div class="rounded-3xl border border-white/10 bg-black/15 p-4">
            <p class="font-medium text-stone-100"><%= booking.booking_ref %></p>
            <p class="text-sm text-stone-500"><%= booking.product.name %> • <%= booking.status.humanize %></p>
            <p class="mt-2 text-sm text-stone-300"><%= booking.customer_user&.full_name || booking.lead_traveler_name %></p>
          </div>
        <% end %>
      </div>
    </div>

    <div class="panel">
      <p class="text-sm uppercase tracking-[0.2em] text-stone-400">Recent payments</p>
      <div class="mt-5 space-y-4">
        <% @payments.limit(5).each do |payment| %>
          <div class="rounded-3xl border border-white/10 bg-black/15 p-4">
            <p class="font-medium text-stone-100"><%= currency_amount(payment.amount_cents, payment.currency) %></p>
            <p class="text-sm text-stone-500"><%= payment.booking.booking_ref %> • <%= payment.status.humanize %></p>
            <p class="mt-2 text-sm text-stone-300"><%= payment.payment_method.humanize %></p>
          </div>
        <% end %>
      </div>
    </div>

    <div class="panel">
      <p class="text-sm uppercase tracking-[0.2em] text-stone-400">Recent support cases</p>
      <div class="mt-5 space-y-4">
        <% @support_cases.limit(5).each do |support_case| %>
          <div class="rounded-3xl border border-white/10 bg-black/15 p-4">
            <p class="font-medium text-stone-100"><%= support_case.case_ref %></p>
            <p class="text-sm text-stone-500"><%= support_case.subject %></p>
            <p class="mt-2 text-sm text-stone-300"><%= support_case.assigned_user&.full_name || "Unassigned" %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
